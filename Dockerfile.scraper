# Xianslate SCRAPER IMAGE (Chromium-heavy) — TARGET TOPOLOGY (App B).
#
# This is the dedicated Playwright/Chromium app the spec calls for: the web/worker tier stays slim and
# delegates page fetches/learning to this isolated app. IT IS A TEMPLATE — wiring the web tier to call this
# scraper over HTTP (instead of the in-process fetcher → headless.ts) is the remaining code step. Until
# then, scraping runs in-process via the main Dockerfile. See DEPLOYMENT.md (“Scraper split”).

FROM mcr.microsoft.com/playwright:v1.60.0-noble AS runtime
ENV NODE_ENV=production
ENV PORT=3001
WORKDIR /app
RUN corepack enable
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile
COPY . .
RUN yarn build
EXPOSE 3001
# THE SCRAPER SERVICE ENTRY (the HTTP wrapper around fetcher/headless) IS THE FOLLOW-UP CODE STEP.
CMD ["node", "build"]
