# DEEPSEEK (OPENAI-COMPATIBLE) API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# deepseek-v4-* THINKS BY DEFAULT (emits reasoning_content, burns output tokens, stalls the stream and
# can return EMPTY content under a token cap). We disable it. Set to `enabled` to turn thinking back on.
DEEPSEEK_REASONING=disabled

# ZYTE API — PRIMARY PAGE-FETCH TRANSPORT (managed proxies + Cloudflare/JS unblocking; no SSRF surface, no
# proxy ops). When ZYTE_API_KEY is set, every chapter/cover fetch goes through Zyte's httpResponseBody tier and
# the per-request cost below is recorded against the chapter's stats. Unset → free
# node-fetch→curl path only. Cost is a PASS-THROUGH ESTIMATE (USD per *successful* request). Zyte bills by
# site-difficulty tier (1–5) and the API does NOT return the per-request tier/cost, so this is a fixed estimate,
# not the exact charge. PAYG per-1k ranges (2026): HTTP $0.13 (T1)→$1.27 (T5). Sites only reach Zyte when the
# free path failed (the harder ones, skewing to tier 3+), so this defaults to TIER-3, not the tier-1 floor.
# MEASURE your real rate from the Zyte invoice (total $ ÷ successful httpResponseBody requests) and set this
# once you have traffic.
ZYTE_API_KEY=your-zyte-key-here
# ZYTE_ENDPOINT=https://api.zyte.com/v1/extract
ZYTE_COST_PER_REQUEST=0.00044
# ZYTE_RPS=2          # per-key RATE cap (Zyte default 2 req/s = 120/min). All Zyte calls are paced to this;
#                     # raise ONLY after Zyte lifts your key's limit (support ticket). Single-process — if you
#                     # run N app instances, set each to ZYTE_RPS/N (they don't share the limiter).
# ZYTE_MAX_RETRIES=4  # 429/503 backoff retries (honoring Retry-After) before degrading to the free fetch path.

# POSTGRESQL (NEON). THREE CONNECTION STRINGS:
#  - DATABASE_URL: POOLED (-pooler host), TRANSACTION MODE — used by the app at runtime (dbWrite/dbRead).
#  - DATABASE_URL_DIRECT: DIRECT/SESSION endpoint — used by migrations (drizzle-kit / npm run db:migrate).
#  - DATABASE_URL_REPLICA: read-replica endpoint (= the pooled primary until a replica is added).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL_REPLICA=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# FIREBASE AUTH — WEB SDK CONFIG (ALL PUBLIC; PUBLIC_ PREFIX EXPOSES THEM TO THE CLIENT).
PUBLIC_FIREBASE_API_KEY=your-web-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef
# SERVER-ONLY: THE WHOLE SERVICE-ACCOUNT KEY FILE AS A SINGLE-LINE JSON STRING (firebase-admin).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# CONCURRENCY / POOL TUNABLES (single process). Defaults shown — raise to handle more concurrent users.
# DEEPSEEK_CONCURRENCY=64   # max parallel translation calls (flash handles thousands; CPU/event-loop is the cap)
# DB_POOL_MAX=25            # postgres.js connections per role (write+read) against Neon's transaction pooler
